# Local examples only. Replace the password before use; never commit .env.
POSTGRES_DB=worksync
POSTGRES_USER=worksync
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=5432
SERVER_PORT=8080

# Optional SMTP: only used when the Spring profile "email" is explicitly activated.
# Host/from must be supplied before enabling; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Exact frontend origins, comma-separated; no paths, trailing slashes or wildcards.
# On Render, include approved Vercel preview and production origins explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
