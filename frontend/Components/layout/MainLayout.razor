@namespace Worksync.Frontend.Components.Layout
@inherits LayoutComponentBase
@implements IDisposable

@inject AuthState Auth
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen"
                       Width="256px"
                       ClipMode="DrawerClipMode.Never"
                       Variant="DrawerVariant.Responsive"
                       Elevation="0"
                       Class="ws-sidebar">

                <div class="ws-sidebar-inner">
                    <div class="ws-logo-area">
                        <a href="/dashboard" class="d-flex align-center">
                            <img src="/images/logo.png" alt="WorkSync" class="ws-sidebar-logo" />
                        </a>
                    </div>

                    <div class="ws-side-scroll">
                        <div class="ws-nav-label">Workspace</div>
                        @if (Auth.IsActiveUser)
                        {
                            <NavLink href="/dashboard" Match="NavLinkMatch.All" class="ws-nav-link">
                                <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" />
                                <span>Overview</span>
                            </NavLink>
                        }
                        else
                        {
                            <NavLink href="/pending-approval" Match="NavLinkMatch.All" class="ws-nav-link">
                                <MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" Size="Size.Small" />
                                <span>Approval Status</span>
                            </NavLink>
                        }

                        @if (Auth.IsActiveAdmin)
                        {
                            <div class="ws-nav-label">Administration</div>
                            <NavLink href="/admin/approvals" Match="NavLinkMatch.Prefix" class="ws-nav-link">
                                <MudIcon Icon="@Icons.Material.Outlined.HowToReg" Size="Size.Small" />
                                <span>Approvals</span>
                            </NavLink>
                            <NavLink href="/admin/users" Match="NavLinkMatch.Prefix" class="ws-nav-link">
                                <MudIcon Icon="@Icons.Material.Outlined.Group" Size="Size.Small" />
                                <span>User Management</span>
                            </NavLink>
                        }
                    </div>
                    <div class="ws-side-bottom">                   

                        <NavLink href="/profile" Match="NavLinkMatch.All" class="ws-nav-link">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Size="Size.Small" />
                            <span>My Profile</span>
                        </NavLink>

                        <button type="button" class="ws-nav-link ws-logout" @onclick="OpenLogoutDialogAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                            <span>Log Out</span>
                        </button>
                    </div>
                </div>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>
<MudAppBar Elevation="0"
           Class="ws-topbar"
           Style="height: 72px; justify-content: flex-start;">

    <AuthorizeView>
        <Authorized>
            <div class="d-flex align-center w-100 px-2">

                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               aria-label="Toggle navigation menu"
                               OnClick="ToggleDrawer"
                               Class="d-md-none mr-2" />

                <MudText Typo="Typo.h6" Class="ws-greeting">
                    Jambo 👋 @GreetingName
                </MudText>

            </div>
        </Authorized>
    </AuthorizeView>

</MudAppBar>

    <MudMainContent Style="background-color: #F6F8FC; min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-7 px-4 px-sm-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private string GreetingName
{
    get
    {
        var firstName = Auth.User?.FirstName?.Trim();

        return string.IsNullOrWhiteSpace(firstName)
            ? "there"
            : firstName;
    }
}


    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await Auth.InitializeAsync();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private async Task OpenLogoutDialogAsync()
    {
        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = true,
            BackgroundClass = "logout-dialog-backdrop"
        };

        await DialogService.ShowAsync<LogoutConfirmDialog>(string.Empty, options);
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}