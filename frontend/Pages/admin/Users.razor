
@page "/admin/users"
@attribute [Authorize(Policy = "ActiveAdmin")]

@using Worksync.Frontend.Models.Shared

@inject UserApiService UserApi
@inject IDialogService DialogService

<PageTitle>User Management · Worksync</PageTitle>

<MudStack Spacing="4">
    <div class="d-flex justify-space-between align-start flex-wrap gap-3">
        <div>
            <p class="ws-eyebrow">Administration</p>
            <h1 class="ws-page-title">User Management</h1>
            <p class="ws-page-desc">View registered accounts and manage their access status.</p>
        </div>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="@_isLoading"
                   OnClick="LoadUsersAsync">
            @(_isLoading ? "Refreshing…" : "Refresh")
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    <section class="ws-panel">
        <div class="ws-panel-header">
            <div>
                <h2>
                    All accounts
                    <span class="ws-pill ml-2">@_totalElements</span>
                </h2>
                <p>Filter accounts by status via the backend API or search the loaded page.</p>
            </div>

            <div class="d-flex align-center gap-2 flex-wrap">
                <div style="min-width: 210px;">
                    <MudTextField T="string"
                                  @bind-Value="_search"
                                  Placeholder="Filter loaded page…"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Search"
                                  Immediate="true" />
                </div>

                <div style="min-width: 170px;">
                    <MudSelect T="string"
                               Value="_statusFilter"
                               ValueChanged="OnStatusFilterChangedAsync"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               aria-label="Filter by account status">
                        <MudSelectItem Value="@("ALL")">All statuses</MudSelectItem>
                        <MudSelectItem Value="@("PENDING_APPROVAL")">Pending</MudSelectItem>
                        <MudSelectItem Value="@("ACTIVE")">Active</MudSelectItem>
                        <MudSelectItem Value="@("BLOCKED")">Blocked</MudSelectItem>
                        <MudSelectItem Value="@("REJECTED")">Rejected</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="pa-10 d-flex justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (FilteredUsers.Count == 0)
        {
            <div class="ws-empty">
                <MudIcon Icon="@Icons.Material.Outlined.GroupOff"
                         Size="Size.Large"
                         Color="Color.Default" />
                <h3>No users found</h3>
                <p>Try selecting another status filter or clearing your search.</p>
            </div>
        }
        else
        {
            <div class="ws-table-wrap">
                <table class="ws-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td>
                                    <div class="ws-person">
                                        <div class="ws-avatar">@GetInitials(user)</div>
                                        <div>
                                            <span class="ws-person-name">
                                                @($"{user.FirstName} {user.LastName}".Trim())
                                            </span>
                                            <span class="ws-person-email">@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Role</td>
                                <td>
                                    <span class="ws-status-pill @user.Status">
                                        @FormatStatus(user.Status)
                                    </span>
                                </td>
                                <td>@(user.CreatedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "—")</td>
                                <td>
                                    <MudButton Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenReviewAsync(user.Id))">
                                        View details
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-space-between align-center pa-4"
             style="border-top: 1px solid #E2E8F0; font-size: 0.78rem; color: #64748B;">
            <span>
                Showing @RangeStart–@RangeEnd of @_totalElements accounts · Page @(_page + 1) / @_totalPages
            </span>

            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="@(_isLoading || _page == 0)"
                           OnClick="PreviousPageAsync">
                    Previous
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="@(_isLoading || _page >= _totalPages - 1)"
                           OnClick="NextPageAsync">
                    Next
                </MudButton>
            </div>
        </div>
    </section>
</MudStack>
