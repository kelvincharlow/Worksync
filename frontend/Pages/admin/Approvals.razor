@page "/admin/approvals"
@attribute [Authorize(Policy = "ActiveAdmin")]

@inject UserApiService UserApi
@inject IDialogService DialogService

<PageTitle>Approvals · Worksync</PageTitle>

<MudStack Spacing="4">
    <div class="d-flex justify-space-between align-start flex-wrap gap-3">
        <div>
            <p class="ws-eyebrow">User &amp; Access</p>
            <h1 class="ws-page-title">Pending Approvals</h1>
            <p class="ws-page-desc">Inspect new registrations and approve or reject requests.</p>
        </div>

        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="@_isLoading"
                   OnClick="LoadApprovalsAsync">
            @(_isLoading ? "Refreshing…" : "Refresh")
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
    }

    <section class="ws-panel">
        <div class="ws-panel-header">
            <div>
                <h2>
                    Awaiting review
                    <span class="ws-pill ml-2">@_totalElements</span>
                </h2>
                <p>Only registered users with a pending account status appear here.</p>
            </div>

            <div style="min-width: 230px;">
                <MudTextField T="string"
                              @bind-Value="_search"
                              Placeholder="Filter loaded page…"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search"
                              Immediate="true" />
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="pa-10 d-flex justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (FilteredUsers.Count == 0)
        {
            <div class="ws-empty">
                <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Size="Size.Large" Color="Color.Success" />
                <h3>@(string.IsNullOrWhiteSpace(_search) ? "No pending registrations" : "No matching applicants on this page")</h3>
                <p>@(string.IsNullOrWhiteSpace(_search) ? "All registration requests have been reviewed." : "Try clearing the filter or checking another page.")</p>
            </div>
        }
        else
        {
            <div class="ws-table-wrap">
                <table class="ws-table">
                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Phone number</th>
                            <th>Registered</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in FilteredUsers)
                        {
                            <tr>
                                <td>
                                    <div class="ws-person">
                                        <div class="ws-avatar">@GetInitials(user)</div>
                                        <div>
                                            <span class="ws-person-name">@($"{user.FirstName} {user.LastName}".Trim())</span>
                                            <span class="ws-person-email">@user.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.PhoneNumber</td>
                                <td>@(user.CreatedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "—")</td>
                                <td><span class="ws-status-pill @user.Status">Pending</span></td>
                                <td>
                                    <MudButton Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               EndIcon="@Icons.Material.Rounded.ArrowForward"
                                               OnClick="@(() => OpenReviewAsync(user.Id))">
                                        Review request
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-space-between align-center pa-4" style="border-top: 1px solid #E2E8F0; font-size: 0.78rem; color: #64748B;">
            <span>
                Page @(_page + 1) of @_totalPages · @_totalElements pending total
            </span>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="@(_isLoading || _page == 0)"
                           OnClick="PreviousPageAsync">
                    Previous
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Disabled="@(_isLoading || _page >= _totalPages - 1)"
                           OnClick="NextPageAsync">
                    Next
                </MudButton>
            </div>
        </div>
    </section>

    <MudText Typo="Typo.caption" Color="Color.Secondary">
        Rejection reasons can be entered for review, but the current WorkSync backend does not store them as audit records.
    </MudText>
</MudStack>

@code {
    private const int PageSize = 20;

    private List<UserRecord> _users = new();
    private string _search = string.Empty;
    private int _page;
    private int _totalPages = 1;
    private long _totalElements;
    private bool _isLoading = true;
    private string? _errorMessage;

    private List<UserRecord> FilteredUsers => string.IsNullOrWhiteSpace(_search)
        ? _users
        : _users.Where(u =>
                $"{u.FirstName} {u.LastName} {u.Email} {u.PhoneNumber}"
                    .Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovalsAsync();
    }

    private async Task LoadApprovalsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await UserApi.GetAdminUsersAsync("PENDING_APPROVAL", _page, PageSize);
            if (result.IsSuccess && result.Data is not null)
            {
                _users = result.Data.Content;
                _totalElements = result.Data.TotalElements;
                _totalPages = result.Data.TotalPages;

                if (_users.Count == 0 && _page > 0 && _totalElements > 0)
                {
                    _page--;
                    await LoadApprovalsAsync();
                }
            }
            else
            {
                _users.Clear();
                _errorMessage = result.ErrorMessage ?? "Could not load pending registrations.";
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_page > 0)
        {
            _page--;
            await LoadApprovalsAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (_page < _totalPages - 1)
        {
            _page++;
            await LoadApprovalsAsync();
        }
    }

    private async Task OpenReviewAsync(string userId)
    {
        var parameters = new DialogParameters<UserReviewDialog>
        {
            { x => x.UserId, userId }
        };

        var options = new DialogOptions
        {
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = true,
            BackgroundClass = "logout-dialog-backdrop"
        };

        var dialog = await DialogService.ShowAsync<UserReviewDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadApprovalsAsync();
        }
    }

    private static string GetInitials(UserRecord user)
    {
        var f = user.FirstName?.Trim();
        var l = user.LastName?.Trim();
        if (!string.IsNullOrEmpty(f) && !string.IsNullOrEmpty(l))
            return $"{char.ToUpperInvariant(f[0])}{char.ToUpperInvariant(l[0])}";
        return !string.IsNullOrEmpty(user.Email) ? char.ToUpperInvariant(user.Email[0]).ToString() : "U";
    }
}