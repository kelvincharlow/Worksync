
@page "/pending-approval"
@attribute [Authorize]
@using Worksync.Frontend.Models.Shared

@inject AuthState Auth
@inject UserApiService UserApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Approval Status · Worksync</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pending-approval-container">
    <MudPaper Elevation="2" Class="pa-6 pa-sm-8 pending-approval-paper">
        <MudStack Spacing="4">
            <div>
                <h1 class="mud-typography mud-typography-h4 font-weight-bold mb-1">
                    Account status
                </h1>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Signed in as <strong>@Auth.User?.Email</strong>
                </MudText>
            </div>

            @if (CurrentStatus == "REJECTED")
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    <strong>Registration rejected.</strong>
                    Your account request was not approved by an administrator.
                    Contact your administrator if you believe this is an error.
                </MudAlert>
            }
            else if (CurrentStatus == "BLOCKED")
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    <strong>Account blocked.</strong>
                    Your access has been suspended. Please contact an administrator.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <strong>Awaiting administrator approval.</strong>
                    Your account is currently
                    <strong>PENDING_APPROVAL</strong>.
                    Your workspace access will unlock once an administrator approves your account.
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_infoMessage))
            {
                <MudAlert Severity="Severity.Normal" Dense="true">
                    @_infoMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @_errorMessage
                </MudAlert>
            }

            <MudStack Row="true" Spacing="2" Class="flex-wrap pt-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_isRefreshing"
                           OnClick="RefreshStatusAsync">
                    @(_isRefreshing ? "Checking status…" : "Refresh status")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>
