@page "/reset-password"
@layout AuthLayout
@implements IDisposable
@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services
@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Reset password · Worksync</PageTitle>

<div class="auth-shell">
    @if (_step == 1)
    {
        <h1 class="auth-title">Enter reset code</h1>
        <p class="auth-subtitle">
            We sent a 6-digit code to <strong>@Email</strong>
        </p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="auth-alert auth-alert-success" role="alert">@_successMessage</div>
        }

        <EditForm Model="@_step1Model" OnValidSubmit="HandleNextStep">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>Verification code</label>
                <InputText class="form-control code-input"
                           @bind-Value="_step1Model.ResetCode"
                           inputmode="numeric"
                           maxlength="6"
                           placeholder="123456"
                           autocomplete="one-time-code" />
                <ValidationMessage For="@(() => _step1Model.ResetCode)" />
            </div>

            <button type="submit" class="btn btn-primary">
                <span>Next</span>
            </button>
        </EditForm>

        <p class="auth-footer">
            Didn't get a code?
            @if (_resendCooldown > 0)
            {
                <span class="auth-link-disabled">Resend in @_resendCooldown s</span>
            }
            else
            {
                <button type="button" class="auth-link" @onclick="HandleResend" disabled="@_isResending">
                    @(_isResending ? "Sending…" : "Resend")
                </button>
            }
        </p>
    }
    else if (_step == 2)
    {
        <h1 class="auth-title">Set new password</h1>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert">@_errorMessage</div>
        }

        <div class="password-rules-box">
            <strong>To protect your account, your password must:</strong>
            <ul>
                <li>Be at least 12 characters long</li>
                <li>Include at least one uppercase and one lowercase letter</li>
                <li>Include at least one number</li>
                <li>Include at least one special character, e.g. !@@#$%^&*</li>
            </ul>
        </div>

        <EditForm Model="@_step2Model" OnValidSubmit="HandleResetPassword">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label>New password</label>
                <div class="password-input-wrapper">
                    <InputText type="@(_showPassword ? "text" : "password")" 
                               class="form-control"
                               @bind-Value="_step2Model.NewPassword"
                               autocomplete="new-password" />
                    <button type="button" class="password-toggle" @onclick="() => _showPassword = !_showPassword">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
                <ValidationMessage For="@(() => _step2Model.NewPassword)" />
            </div>

            <div class="form-group mb-4">
                <label>Confirm password</label>
                <div class="password-input-wrapper">
                    <InputText type="@(_showConfirmPassword ? "text" : "password")" 
                               class="form-control"
                               @bind-Value="_confirmPassword"
                               autocomplete="new-password" />
                    <button type="button" class="password-toggle" @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                        @(_showConfirmPassword ? "Hide" : "Show")
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_confirmError))
                {
                    <div class="validation-message" style="display:block;">@_confirmError</div>
                }
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border" role="status" aria-hidden="true"></span>
                    <span>Resetting…</span>
                }
                else
                {
                    <span>Reset password</span>
                }
            </button>
        </EditForm>
    }
    else if (_step == 3)
    {
        <div class="text-center" style="margin-top: 40px;">
            <div class="success-icon-wrapper">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 13l4 4L19 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <h1 class="auth-title">Password reset</h1>
            <p class="auth-subtitle" style="margin-bottom: 32px;">
                Your password has been successfully reset. You can now sign in with your new password.
            </p>
            <button type="button" class="btn btn-primary" @onclick="GoToLogin">
                <span>Back to sign in</span>
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private int _step = 1;
    
    // Step 1 State
    private PasswordResetConfirmRequest _step1Model = new(); // Reuse for code
    private bool _isResending;
    private int _resendCooldown;
    private System.Threading.Timer? _timer;
    private string? _successMessage;

    // Step 2 State
    private PasswordResetConfirmRequest _step2Model = new();
    private string _confirmPassword = string.Empty;
    private string? _confirmError;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private bool _isLoading;
    
    // Shared Error State
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            Navigation.NavigateTo("/forgot-password");
            return;
        }
        _step1Model.Email = Email;
        _step2Model.Email = Email;
    }

    private void HandleNextStep()
    {
        _errorMessage = null;
        _step = 2; // Move to password entry
    }

    private async Task HandleResetPassword()
    {
        _errorMessage = null;
        _confirmError = null;

        if (_step2Model.NewPassword != _confirmPassword)
        {
            _confirmError = "Passwords do not match.";
            return;
        }

        _isLoading = true;

        // Combine Step 1 and Step 2 data for the final API call
        _step2Model.ResetCode = _step1Model.ResetCode;

        var result = await AuthApi.ConfirmPasswordResetAsync(_step2Model);

        if (result.IsSuccess)
        {
            _step = 3; // Move to success screen
            Snackbar.Add("Password changed successfully", Severity.Success);
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "The code is invalid or has expired. Please check and try again.";
            // If the code was invalid/expired, optionally send them back to step 1
            if (result.StatusCode == 400)
            {
                _step = 1;
                _errorMessage = "Invalid or expired reset code. Please request a new one.";
            }
        }

        _isLoading = false;
    }

    private async Task HandleResend()
    {
        if (_resendCooldown > 0 || _isResending) return;

        _isResending = true;
        _errorMessage = null;
        _successMessage = null;

        var result = await AuthApi.RequestPasswordResetAsync(new PasswordResetRequest { Email = Email! });

        if (result.IsSuccess)
        {
            _successMessage = "A new code has been sent to your email.";
            StartCooldown(60); // 60 seconds per API doc
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Could not resend the code. Please try again.";
        }

        _isResending = false;
    }

    private void StartCooldown(int seconds)
    {
        _resendCooldown = seconds;
        _timer?.Dispose();
        _timer = new System.Threading.Timer(_ =>
        {
            if (_resendCooldown > 0)
            {
                _resendCooldown--;
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login?passwordReset=true");
    }

    public void Dispose() => _timer?.Dispose();
}