
@page "/reset-password"
@layout AuthLayout
@implements IDisposable

@using System.ComponentModel.DataAnnotations
@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services
@using MudBlazor

@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Reset password · Worksync</PageTitle>

<div class="auth-shell">

    @* STEP 1: VERIFICATION CODE *@
    @if (_step == 1)
    {
        <h1 class="auth-title">Enter reset code</h1>

        <p class="auth-subtitle">
            We sent a 6-digit code to <strong>@Email</strong>
        </p>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="auth-alert auth-alert-success" role="alert">
                @_successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert">
                @_errorMessage
            </div>
        }

        <EditForm Model="@_step1Model"
                  OnValidSubmit="HandleNextStep">

            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Verification code</label>

                <InputText class="form-control code-input"
                           @bind-Value="_step1Model.ResetCode"
                           inputmode="numeric"
                           maxlength="6"
                           placeholder="123456"
                           autocomplete="one-time-code" />

                <ValidationMessage
                    For="@(() => _step1Model.ResetCode)" />
            </div>

            <button type="submit" class="btn btn-primary">
                <span>Next</span>
            </button>

        </EditForm>

        <p class="auth-footer">
            Didn't get a code?

            @if (_resendCooldown > 0)
            {
                <span class="auth-link-disabled">
                    Resend in @_resendCooldown s
                </span>
            }
            else
            {
                <button type="button"
                        class="auth-link"
                        @onclick="HandleResend"
                        disabled="@_isResending">

                    @(_isResending ? "Sending..." : "Resend")
                </button>
            }
        </p>
    }
    else if (_step == 2)
    {
        @* STEP 2: SET NEW PASSWORD *@

        <h1 class="auth-title">Set new password</h1>

        <p class="auth-subtitle">
            Create a new password for your account.
        </p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert">
                @_errorMessage
            </div>
        }

        <div class="password-rules-box">
            <strong>Your password must:</strong>

            <ul>
                <li>Be at least 12 characters long</li>
                <li>Not exceed 128 characters</li>
            </ul>
        </div>

        <EditForm Model="@_step2Model"
                  OnValidSubmit="HandleResetPassword">

            <DataAnnotationsValidator />
            <ValidationSummary />

            @* NEW PASSWORD *@
            <div class="form-group">
                <label>New password</label>

                <div class="password-input-wrapper">

                    <InputText
                        type="@(_showPassword ? "text" : "password")"
                        class="form-control"
                        @bind-Value="_step2Model.NewPassword"
                        minlength="12"
                        maxlength="128"
                        autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            @onclick="() => _showPassword = !_showPassword">

                        @(_showPassword ? "Hide" : "Show")
                    </button>

                </div>

                <ValidationMessage
                    For="@(() => _step2Model.NewPassword)" />
            </div>

            @* CONFIRM PASSWORD *@
            <div class="form-group mb-4">
                <label>Confirm password</label>

                <div class="password-input-wrapper">

                    <InputText
                        type="@(_showConfirmPassword ? "text" : "password")"
                        class="form-control"
                        @bind-Value="_confirmPassword"
                        autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            @onclick="() => _showConfirmPassword = !_showConfirmPassword">

                        @(_showConfirmPassword ? "Hide" : "Show")
                    </button>

                </div>

                @if (!string.IsNullOrEmpty(_confirmError))
                {
                    <div class="validation-message">
                        @_confirmError
                    </div>
                }
                else if (!string.IsNullOrEmpty(_confirmPassword))
                {
                    @if (_step2Model.NewPassword == _confirmPassword)
                    {
                        <div class="password-match-message">
                            Passwords match.
                        </div>
                    }
                    else
                    {
                        <div class="validation-message">
                            Passwords do not match.
                        </div>
                    }
                }
            </div>

            @* RESET PASSWORD BUTTON *@
            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isLoading">

                @if (_isLoading)
                {
                    <span class="spinner-border"
                          role="status"
                          aria-hidden="true"></span>

                    <span>Resetting...</span>
                }
                else
                {
                    <span>Reset password</span>
                }

            </button>

        </EditForm>

        <p class="auth-footer">
            <button type="button"
                    class="auth-link"
                    @onclick="GoBackToCode">

                Back to verification code
            </button>
        </p>
    }
    else if (_step == 3)
    {
        @* STEP 3: PASSWORD RESET SUCCESS *@

        <div class="text-center" style="margin-top: 40px;">

            <div class="success-icon-wrapper">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M5 13l4 4L19 7"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                </svg>

            </div>

            <h1 class="auth-title">Password reset</h1>

            <p class="auth-subtitle" style="margin-bottom: 32px;">
                Your password has been successfully reset.
                You can now sign in with your new password.
            </p>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="GoToLogin">

                <span>Back to sign in</span>

            </button>

        </div>
    }

</div>

@code {

    // ==========================================
    // EMAIL FROM URL
    // Example: /reset-password?email=test@example.com
    // ==========================================

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }


    // ==========================================
    // STEP 1: VERIFICATION CODE MODEL
    // ==========================================

    private class ResetCodeStepModel
    {
        [Required(ErrorMessage = "Reset code is required.")]

        [RegularExpression(
            @"^\d{6}$",
            ErrorMessage = "Enter a valid 6-digit reset code.")]

        public string ResetCode { get; set; } = string.Empty;
    }

    private ResetCodeStepModel _step1Model = new();


    // ==========================================
    // CURRENT SCREEN
    // ==========================================

    private int _step = 1;


    // ==========================================
    // STEP 1: RESEND CODE VARIABLES
    // ==========================================

    private bool _isResending;

    private int _resendCooldown;

    private System.Threading.Timer? _timer;

    private string? _successMessage;


    // STEP 2: PASSWORD VARIABLES
   
    private PasswordResetConfirmRequest _step2Model = new();

    private string _confirmPassword = string.Empty;

    private string? _confirmError;

    private bool _showPassword;

    private bool _showConfirmPassword;

    private bool _isLoading;


    // ==========================================
    // ERROR MESSAGE
    // ==========================================

    private string? _errorMessage;


    // ==========================================
    // INITIALIZATION
    // ==========================================

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            Navigation.NavigateTo("/forgot-password");
            return;
        }

        _step2Model.Email = Email;
    }


    
    // STEP 1 -> STEP 2
    // ==========================================

    
private void HandleNextStep()
{
    _errorMessage = null;
    _successMessage = null;
    _confirmError = null;

    _confirmPassword = string.Empty;

    // Copy the email and verification code.
    _step2Model.Email = Email!;
    _step2Model.ResetCode = _step1Model.ResetCode.Trim();

    // Move to the new password screen.
    _step = 2;
}

    // STEP 2 -> STEP 1
    

    private void GoBackToCode()
    {
        _errorMessage = null;
        _confirmError = null;

        _step = 1;
    }


    // ==========================================
    // RESET PASSWORD
    // CONNECT TO BACKEND
    // ==========================================

    private async Task HandleResetPassword()
    {
        _errorMessage = null;
        _confirmError = null;

        // Check whether passwords match.

        if (_step2Model.NewPassword != _confirmPassword)
        {
            _confirmError = "Passwords do not match.";
            return;
        }

        // Check password length.

        if (string.IsNullOrWhiteSpace(_step2Model.NewPassword) ||
            _step2Model.NewPassword.Length < 12 ||
            _step2Model.NewPassword.Length > 128)
        {
            _errorMessage =
                "Password must be between 12 and 128 characters.";

            return;
        }

        // Prevent duplicate submissions.

        if (_isLoading)
        {
            return;
        }

        _isLoading = true;

        try
        {
            // Attach email and verification code.

            _step2Model.Email = Email!;

            _step2Model.ResetCode =
                _step1Model.ResetCode.Trim();

            // Send password reset request to backend.

            var result =
                await AuthApi.ConfirmPasswordResetAsync(_step2Model);

            if (result.IsSuccess)
            {
                // Show success screen only after backend confirmation.

                _step = 3;

                Snackbar.Add(
                    "Password changed successfully",
                    Severity.Success);
            }
            else
            {
                _errorMessage = result.ErrorMessage ??
                    "Password reset failed. Please check your details and try again.";
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "Unable to connect to the server. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage =
                "Something went wrong while resetting your password.";
        }
        finally
        {
            _isLoading = false;
        }
    }


    // ==========================================
    // RESEND VERIFICATION CODE
    // ==========================================

    private async Task HandleResend()
    {
        if (_resendCooldown > 0 || _isResending)
        {
            return;
        }

        _isResending = true;

        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new PasswordResetRequest
            {
                Email = Email!
            };

            var result =
                await AuthApi.RequestPasswordResetAsync(request);

            if (result.IsSuccess)
            {
                _successMessage =
                    "If the account exists, a new reset code will be sent to your email.";

                StartCooldown(60);
            }
            else
            {
                _errorMessage = result.ErrorMessage ??
                    "Could not resend the code. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "Unable to connect to the server. Please try again.";
        }
        catch (Exception)
        {
            _errorMessage =
                "Something went wrong while requesting another code.";
        }
        finally
        {
            _isResending = false;
        }
    }


    // ==========================================
    // RESEND COUNTDOWN
    // ==========================================

    private void StartCooldown(int seconds)
    {
        _resendCooldown = seconds;

        _timer?.Dispose();

        _timer = new System.Threading.Timer(state =>
        {
            _ = InvokeAsync(() =>
            {
                if (_resendCooldown > 0)
                {
                    _resendCooldown--;
                }

                if (_resendCooldown == 0)
                {
                    _timer?.Dispose();
                    _timer = null;
                }

                StateHasChanged();
            });

        }, null, 1000, 1000);
    }


    // ==========================================
    // NAVIGATE TO LOGIN
    // ==========================================

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login?passwordReset=true");
    }


    // ==========================================
    // CLEAN UP TIMER
    // ==========================================

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }

}
