@page "/reset-password"
@layout AuthLayout
@implements IDisposable

@using System.ComponentModel.DataAnnotations
@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services
@using MudBlazor

@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Reset password · Worksync</PageTitle>

<div class="auth-shell">
    @if (_step == 1)
    {
        <h1 class="auth-title">Enter reset code</h1>
        <p class="auth-subtitle">
            If an account exists for <strong>@Email</strong>, a 6-digit reset code has been sent.
        </p>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="auth-alert auth-alert-success" role="status" aria-live="polite">@_successMessage</div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert" aria-live="assertive">@_errorMessage</div>
        }

        <EditForm Model="@_step1Model" OnValidSubmit="HandleNextStep">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="reset-code">Verification code</label>
                <InputText id="reset-code"
                           class="form-control code-input"
                           @bind-Value="_step1Model.ResetCode"
                           inputmode="numeric"
                           maxlength="6"
                           placeholder="123456"
                           autocomplete="one-time-code" />
                <ValidationMessage For="@(() => _step1Model.ResetCode)" />
            </div>

            <button type="submit" class="btn btn-primary">
                <span>Next</span>
            </button>
        </EditForm>

        <p class="auth-footer">
            Didn't get a code?
            @if (_resendCooldown > 0)
            {
                <span class="auth-link-disabled">
                    Wait @_resendCooldown s before retrying
                </span>
            }
            else
            {
                <button type="button"
                        class="auth-link"
                        @onclick="HandleResendAsync"
                        disabled="@_isResending">
                    @(_isResending ? "Sending…" : "Request another code")
                </button>
            }
        </p>
    }
    else if (_step == 2)
    {
        <h1 class="auth-title">Set new password</h1>
        <p class="auth-subtitle">
            Create a new password for your account. Your reset code will be verified when you submit.
        </p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="auth-alert auth-alert-danger" role="alert" aria-live="assertive">@_errorMessage</div>
        }

        <div class="password-rules-box">
            <strong>Your password must:</strong>
            <ul>
                <li>Be at least 12 characters long</li>
                <li>Not exceed 128 characters</li>
            </ul>
        </div>

        <EditForm EditContext="@_step2EditContext" OnValidSubmit="HandleResetPasswordAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="new-password">New password</label>
                <div class="password-input-wrapper">
                    <InputText id="new-password"
                               type="@(_showPassword ? "text" : "password")"
                               class="form-control"
                               @bind-Value="_step2Model.NewPassword"
                               minlength="12"
                               maxlength="128"
                               autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            aria-label="@(_showPassword ? "Hide new password" : "Show new password")"
                            aria-pressed="@_showPassword"
                            @onclick="() => _showPassword = !_showPassword">
                        @(_showPassword ? "Hide" : "Show")
                    </button>
                </div>
                <ValidationMessage For="@(() => _step2Model.NewPassword)" />
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm password</label>
                <div class="password-input-wrapper">
                    <InputText id="confirm-password"
                               type="@(_showConfirmPassword ? "text" : "password")"
                               class="form-control"
                               @bind-Value="_step2Model.ConfirmPassword"
                               autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            aria-label="@(_showConfirmPassword ? "Hide confirm password" : "Show confirm password")"
                            aria-pressed="@_showConfirmPassword"
                            @onclick="() => _showConfirmPassword = !_showConfirmPassword">
                        @(_showConfirmPassword ? "Hide" : "Show")
                    </button>
                </div>
                <ValidationMessage For="@(() => _step2Model.ConfirmPassword)" />
                @if (!string.IsNullOrEmpty(_step2Model.ConfirmPassword)
                     && _step2Model.NewPassword == _step2Model.ConfirmPassword)
                {
                    <div class="password-match-message">Passwords match.</div>
                }
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border" role="status" aria-hidden="true"></span>
                    <span>Resetting…</span>
                }
                else
                {
                    <span>Reset password</span>
                }
            </button>
        </EditForm>

        <p class="auth-footer">
            <button type="button" class="auth-link" @onclick="GoBackToCode">
                Back to verification code
            </button>
        </p>
    }
    else if (_step == 3)
    {
        <div class="text-center" style="margin-top: 24px;">
            <div class="success-icon-wrapper" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 13l4 4L19 7"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>

            <h1 class="auth-title">Password reset</h1>
            <p class="auth-subtitle" style="margin-bottom: 32px;">
                Your password has been successfully reset. You can now sign in with your new password.
            </p>

            <button type="button" class="btn btn-primary" @onclick="GoToLogin">
                <span>Back to sign in</span>
            </button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "sent")]
    public bool? Sent { get; set; }

    private sealed class ResetCodeStepModel
    {
        [Required(ErrorMessage = "Reset code is required.")]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "Enter a valid 6-digit reset code.")]
        public string ResetCode { get; set; } = string.Empty;
    }

    private sealed class ResetPasswordStep2Model
    {
        [Required(ErrorMessage = "New password is required.")]
        [StringLength(128, MinimumLength = 12, ErrorMessage = "Password must be between 12 and 128 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private readonly ResetCodeStepModel _step1Model = new();
    private readonly ResetPasswordStep2Model _step2Model = new();
    private EditContext _step2EditContext = default!;
    private ValidationMessageStore _step2MessageStore = default!;

    private int _step = 1;
    private bool _isResending;
    private int _resendCooldown;
    private bool _initialCooldownStarted;
    private System.Threading.Timer? _timer;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private bool _isLoading;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            Navigation.NavigateTo("/forgot-password");
            return;
        }

        _step2EditContext = new EditContext(_step2Model);
        _step2MessageStore = new ValidationMessageStore(_step2EditContext);
        _step2EditContext.OnFieldChanged += (_, args) => _step2MessageStore.Clear(args.FieldIdentifier);

        if (Sent == true && !_initialCooldownStarted)
        {
            _initialCooldownStarted = true;
            StartCooldown(60);
        }
    }

    private void HandleNextStep()
    {
        _errorMessage = null;
        _successMessage = null;
        _step2MessageStore.Clear();
        _step = 2;
    }

    private void GoBackToCode()
    {
        _errorMessage = null;
        _step2MessageStore.Clear();
        _step = 1;
    }

    private async Task HandleResetPasswordAsync()
    {
        if (_isLoading) return;

        _isLoading = true;
        _errorMessage = null;
        _step2MessageStore.Clear();

        try
        {
            var request = new PasswordResetConfirmRequest
            {
                Email = Email!.Trim(),
                ResetCode = _step1Model.ResetCode.Trim(),
                NewPassword = _step2Model.NewPassword
            };

            var result = await AuthApi.ConfirmPasswordResetAsync(request);

            if (result.IsSuccess)
            {
                _step = 3;
                Snackbar.Add("Password changed successfully.", Severity.Success);
                return;
            }

            if (result.StatusCode == 429)
            {
                _errorMessage = result.ErrorMessage ?? "Too many attempts. Please wait before trying again.";
                return;
            }

            var unmapped = _step2EditContext.ApplyFieldErrors(_step2MessageStore, _step2Model, result.FieldErrors);
            _errorMessage = unmapped.Count > 0
                ? string.Join(" ", unmapped)
                : (result.ErrorMessage ?? "Password reset failed. Please verify your code and try again.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleResendAsync()
    {
        if (_resendCooldown > 0 || _isResending) return;

        _isResending = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await AuthApi.RequestPasswordResetAsync(new PasswordResetRequest
            {
                Email = Email!.Trim()
            });

            if (result.IsSuccess)
            {
                _successMessage = "If an eligible account exists, a new reset code has been requested.";
                StartCooldown(60);
                return;
            }

            if (result.StatusCode == 429)
            {
                _errorMessage = result.ErrorMessage ?? "Too many requests. Please wait before requesting another code.";
                StartCooldown(60);
                return;
            }

            _errorMessage = result.ErrorMessage ?? "Could not request another code. Please try again.";
        }
        finally
        {
            _isResending = false;
        }
    }

    private void StartCooldown(int seconds)
    {
        _resendCooldown = seconds;
        _timer?.Dispose();

        _timer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                if (_resendCooldown > 0)
                    _resendCooldown--;

                if (_resendCooldown == 0)
                {
                    _timer?.Dispose();
                    _timer = null;
                }

                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login?passwordReset=true");
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}