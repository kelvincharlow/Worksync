
@page "/forgot-password"
@layout AuthLayout

@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services

@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Forgot password · Worksync</PageTitle>

<div class="auth-shell">
    <h1 class="auth-title">Forgot password?</h1>

    <p class="auth-subtitle">
        Enter the email on your account. If an eligible account exists, we'll send a reset code.
    </p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-alert auth-alert-danger"
             role="alert"
             aria-live="assertive">
            @_errorMessage
        </div>
    }

    <EditForm EditContext="@_editContext" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="forgot-email">Email address</label>

            <InputText id="forgot-email"
                       type="email"
                       class="form-control"
                       @bind-Value="_model.Email"
                       placeholder="jane.doe@example.com"
                       autocomplete="email" />

            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@_isLoading">

            @if (_isLoading)
            {
                <span class="spinner-border"
                      role="status"
                      aria-hidden="true">
                </span>

                <span>Sending…</span>
            }
            else
            {
                <span>Send code</span>
            }
        </button>
    </EditForm>

    <p class="auth-footer">
        Remembered your password?
        <a href="/login" class="auth-link">Sign in</a>
    </p>
</div>
