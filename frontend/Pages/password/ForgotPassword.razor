@page "/forgot-password"
@layout AuthLayout
@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Forgot password · Worksync</PageTitle>

<div class="auth-shell">
    <h1 class="auth-title">Forgot password?</h1>
    <p class="auth-subtitle">
        Enter the email on your account and we'll send you a code to reset your password
    </p>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-alert auth-alert-danger" role="alert">@_errorMessage</div>
    }

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label>Email address</label>
            <InputText type="email" class="form-control"
                       @bind-Value="_model.Email"
                       placeholder="jane.doe@example.com"
                       autocomplete="email" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border" role="status" aria-hidden="true"></span>
                <span>Sending…</span>
            }
            else
            {
                <span>Send code</span>
            }
        </button>
    </EditForm>

    <p class="auth-footer">
        Remembered your password? <a href="/login" class="auth-link">Sign in</a>
    </p>
</div>

@code {
    private PasswordResetRequest _model = new();
    private bool _isLoading;
    private string? _errorMessage;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await AuthApi.RequestPasswordResetAsync(_model);

        if (result.IsSuccess)
        {
            // Anti-enumeration: the API returns 200 whether or not the email exists.
            // Always continue to the code screen.
            Navigation.NavigateTo($"/reset-password?email={Uri.EscapeDataString(_model.Email)}");
            return;
        }

        _errorMessage = result.ErrorMessage ?? "Something went wrong. Please try again.";
        _isLoading = false;
    }
}