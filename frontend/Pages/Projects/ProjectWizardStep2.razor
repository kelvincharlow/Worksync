
@namespace Worksync.Frontend.Pages.Projects

<div class="wizard-page">

    <!-- Header -->
    <div class="wizard-header">
        <div>
            <p class="eyebrow">New Project</p>
            <h1 class="wizard-title">Create a project</h1>
            <p class="wizard-subtitle">
                A focused setup that adapts to how your team works.
            </p>
        </div>

        <button type="button"
                class="btn btn-secondary"
                @onclick="HandleSaveDraft">
            Save draft
        </button>
    </div>

    <!-- Six-step progress tracker -->
    <div class="stepper-card">
        <ol class="stepper">
            @foreach (var step in Steps)
            {
                var state = step.Number == CurrentStep ? "active"
                          : step.Number < CurrentStep ? "done"
                          : "upcoming";

                <li class="stepper-item @state">
                    <span class="stepper-circle">
                        @if (state == "done")
                        {
                            <span class="check">&#10003;</span>
                        }
                        else
                        {
                            @step.Number
                        }
                    </span>

                    <span class="stepper-label">
                        @step.Label
                    </span>

                    @if (step.Number != TotalSteps)
                    {
                        <span class="stepper-line"></span>
                    }
                </li>
            }
        </ol>
    </div>

    <!-- Approach form -->
    <div class="form-card">

        <p class="eyebrow">
            Step @CurrentStep of @TotalSteps
        </p>

        <h2 class="form-title">
            How does your team prefer to work?
        </h2>

        <p class="form-subtitle">
            Pick a practical starting point. You can adapt your workspace
            as the project evolves.
        </p>

        <!-- Approach options -->
        <div class="approach-grid">

            @foreach (var option in Approaches)
            {
                var isSelected = IsSelected(option);

                var classes = "approach-card"
                    + (isSelected ? " selected" : "")
                    + (option.Disabled ? " disabled" : "");

                <button type="button"
                        class="@classes"
                        disabled="@option.Disabled"
                        aria-pressed="@isSelected"
                        @onclick="() => SelectApproachAsync(option)">

                    <div class="approach-icon">
                        @switch (option.IconSvgPath)
                        {
                            case "icon-list":
                                <svg width="20" height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <rect x="3" y="3" width="18"
                                          height="18" rx="2" />
                                    <line x1="7" y1="8"
                                          x2="17" y2="8" />
                                    <line x1="7" y1="12"
                                          x2="17" y2="12" />
                                    <line x1="7" y1="16"
                                          x2="13" y2="16" />
                                </svg>
                                break;

                            case "icon-board":
                                <svg width="20" height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <rect x="3" y="3" width="18"
                                          height="18" rx="2" />
                                    <line x1="9" y1="3"
                                          x2="9" y2="21" />
                                    <line x1="15" y1="3"
                                          x2="15" y2="21" />
                                </svg>
                                break;

                            case "icon-calendar":
                                <svg width="20" height="20"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <rect x="3" y="4" width="18"
                                          height="18" rx="2" />
                                    <line x1="3" y1="10"
                                          x2="21" y2="10" />
                                    <line x1="8" y1="2"
                                          x2="8" y2="6" />
                                    <line x1="16" y1="2"
                                          x2="16" y2="6" />
                                </svg>
                                break;
                        }
                    </div>

                    @if (isSelected)
                    {
                        <span class="approach-check"
                              aria-hidden="true">
                            &#10003;
                        </span>
                    }

                    <h3 class="approach-title">
                        @option.Title
                    </h3>

                    <p class="approach-description">
                        @option.Description
                    </p>

                    @if (!string.IsNullOrEmpty(option.Badge))
                    {
                        <span class="approach-badge">
                            @option.Badge
                        </span>
                    }

                </button>
            }

        </div>

        <!-- Information banner -->
        <div class="info-banner">
            Both available approaches use the same work records.
            The board is a view, not a separate task database.
        </div>

        <!-- Footer -->
        <div class="form-footer">

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="HandleBack">
                Back
            </button>

            <span class="step-counter">
                @CurrentStep / @TotalSteps
            </span>

            <button type="button"
                    class="btn btn-primary"
                    disabled="@string.IsNullOrEmpty(_selectedApproachId)"
                    @onclick="HandleContinue">
                Continue
                <span class="arrow">&rarr;</span>
            </button>

        </div>

    </div>

</div>
