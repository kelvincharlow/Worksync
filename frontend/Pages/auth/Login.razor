@page "/login"
@layout AuthLayout

@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services

@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject AuthState Auth

<PageTitle>Sign in · Worksync</PageTitle>

<div class="auth-shell auth-card">
    <div class="text-center">
        <img src="/images/logo.png" alt="WorkSync Logo" class="auth-card-logo" />
        @* <h1 class="auth-title">Welcome back</h1> *@
        <p class="auth-subtitle">Signing in </p>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="auth-alert auth-alert-success" role="status" aria-live="polite">@_successMessage</div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-alert auth-alert-danger" role="alert" aria-live="assertive">@_errorMessage</div>
    }

    <EditForm EditContext="@_editContext" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="login-email">Email</label>
            <InputText id="login-email"
                       type="email"
                       class="form-control"
                       @bind-Value="_loginModel.Email"
                       placeholder="johnbrown@example.com"
                       autocomplete="username" />
            <ValidationMessage For="@(() => _loginModel.Email)" />
        </div>

        <div class="form-group">
            <label for="login-password">Password</label>
            <div class="password-input-wrapper">
                <InputText id="login-password"
                           type="@(_showPassword ? "text" : "password")"
                           class="form-control"
                           @bind-Value="_loginModel.Password"
                           placeholder="••••••••••••"
                           autocomplete="current-password" />
                <button type="button"
                        class="password-toggle"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                        aria-pressed="@_showPassword"
                        @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="@(() => _loginModel.Password)" />
            <div class="auth-inline-row">
                <a href="/forgot-password" class="auth-link" style="font-size: 0.85rem;">
                    Forgot password?
                </a>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border" role="status" aria-hidden="true"></span>
                <span>Signing in…</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </button>
    </EditForm>

    <p class="auth-footer">
        Don't have an account? <a href="/register" class="auth-link">sign up</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "registered")]
    public bool? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "passwordReset")]
    public bool? PasswordReset { get; set; }
    [SupplyParameterFromQuery(Name = "sessionExpired")]
    public bool? SessionExpired { get; set; }

    private readonly LoginRequest _loginModel = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private bool _isLoading;
    private bool _showPassword;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_loginModel);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (_, args) => _messageStore.Clear(args.FieldIdentifier);

        if (Registered == true)
            _successMessage = "Account created. An administrator must approve it before you can access the workspace.";
        else if (PasswordReset == true)
            _successMessage = "Password reset complete. You can now sign in with your new password.";
        else if (SessionExpired == true)
            _errorMessage = "Your session has expired. Please sign in again.";
    }

    private async Task HandleLoginAsync()
    {
        if (_isLoading) return;

        _isLoading = true;
        _errorMessage = null;
        _messageStore.Clear();

        try
        {
            var result = await AuthApi.LoginAsync(_loginModel);

            if (!result.IsSuccess || result.Data is null)
            {
                var unmapped = _editContext.ApplyFieldErrors(_messageStore, _loginModel, result.FieldErrors);
                _errorMessage = unmapped.Count > 0
                    ? string.Join(" ", unmapped)
                    : (result.ErrorMessage ?? "Sign-in failed. Please try again.");
                return;
            }

            var auth = result.Data;
            if (string.IsNullOrWhiteSpace(auth.AccessToken))
            {
                _errorMessage = "Unexpected response from the server. Please try again.";
                return;
            }

           await Auth.SetSessionAsync(auth.AccessToken, auth.RefreshToken, auth.ExpiresIn, auth.User);

            switch (auth.User?.Status)
            {
                case "PENDING_APPROVAL":
                    Navigation.NavigateTo("/pending-approval");
                    break;
                case "ACTIVE":
                    Navigation.NavigateTo(SafeReturnUrl() ?? "/dashboard");
                    break;
                default:
                    await Auth.ClearAsync();
                    _errorMessage = auth.User?.Status == "BLOCKED"
                        ? "Your account has been blocked. Contact your administrator."
                        : "Your account was not approved. Contact your administrator.";
                    break;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string? SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl)) return null;
        if (ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\"))
            return ReturnUrl;
        return null;
    }
}