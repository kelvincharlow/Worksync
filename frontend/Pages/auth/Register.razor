@page "/"
@page "/register"
@layout AuthLayout
@using Worksync.Frontend.Models.Auth 
@inject AuthApiService AuthApi   
@inject NavigationManager Navigation
@using System.Net.Http.Json


<div class="register-container">
    <div class="register-card">
        <!-- Brand Logo and Header -->
        <div class="text-center mb-4">
                        <img src="frontend\wwwroot\images\Logo.png"
                 alt="WorkSync"
                 class="auth-brand" />

            <h2 class="mt-3 font-weight-bold">Create your account</h2>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
               {
            <div class="alert alert-danger" role="alert">
                @_errorMessage
            </div>
        }

        <EditForm Model="@_register" OnValidSubmit="HandleRegistration">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label>First name</label>
                <InputText class="form-control" @bind-Value="_register.FirstName" placeholder="First name" />
                <ValidationMessage For="@(() => _register.FirstName)" />
            </div>

            <div class="form-group mb-3">
                <label>Last name</label>
                <InputText class="form-control" @bind-Value="_register.LastName" placeholder="Last name" />
                <ValidationMessage For="@(() => _register.LastName)" />
            </div>

            <div class="form-group mb-3">
                <label>Email</label>
                <InputText type="email" class="form-control" @bind-Value="_register.Email" placeholder="jane.doe@example.com" />
                <ValidationMessage For="@(() => _register.Email)" />
            </div>

            <div class="form-group mb-3">
                <label>Phone number</label>
                <InputText class="form-control" @bind-Value="_register.PhoneNumber" placeholder="+254712345678" />
                <ValidationMessage For="@(() => _register.PhoneNumber)" />
            </div>

            <div class="form-group mb-4">
                <label>Password</label>
                <InputText type="password" class="form-control" @bind-Value="_register.Password" placeholder="••••••••" />
                <ValidationMessage For="@(() => _register.Password)" />
            </div>

            <button type="submit" class="btn btn-primary btn-block w-100 py-2" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create account</span>
                }
            </button>
        </EditForm>

        <div class="text-center mt-3">
            <p class="text-muted">Already have an account? <a href="/login">Sign in.</a></p>
        </div>
    </div>
</div>

@code {
    private RegistrationRequest _register = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    private async Task HandleRegistration()
{
    _isLoading = true;
    _errorMessage = null;

    var result = await AuthApi.RegisterAsync(_register);

    if (result.IsSuccess)
    {
        Navigation.NavigateTo("/login?registered=true");
        return;
    }

    _errorMessage = result.ErrorMessage ?? "Registration failed. Please check your inputs.";
    _isLoading = false;
}

    }