@page "/"
@page "/register"
@layout AuthLayout

@using Worksync.Frontend.Models.Auth
@using Worksync.Frontend.Services

@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Create account · Worksync</PageTitle>

<div class="auth-shell auth-card auth-card-register">
    <div class="text-center">
        <img src="/images/logo.png" alt="WorkSync Logo" class="auth-card-logo" />
        <h1 class="auth-title">Create your account</h1>
        @* <p class="auth-subtitle">Join your workspace. New accounts require administrator approval.</p> *@
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="auth-alert auth-alert-danger" role="alert" aria-live="assertive">@_errorMessage</div>
    }

    <EditForm EditContext="@_editContext" OnValidSubmit="HandleRegistrationAsync">
        <DataAnnotationsValidator />

        <div class="form-row-2">

            <div class="form-group">
                <label for="reg-first-name">First name</label>
                <InputText id="reg-first-name"
                        class="form-control"
                        @bind-Value="_register.FirstName"
                        placeholder="John"
                        autocomplete="given-name" />
                <ValidationMessage For="@(() => _register.FirstName)" />
            </div>

            <div class="form-group">
                <label for="reg-last-name">Last name</label>
                <InputText id="reg-last-name"
                        class="form-control"
                        @bind-Value="_register.LastName"
                        placeholder="Brown"
                        autocomplete="family-name" />
                <ValidationMessage For="@(() => _register.LastName)" />
            </div>
        </div>

         <div class="form-row-2">    

            <div class="form-group">
                <label for="reg-email">Email address</label>
                <InputText id="reg-email"
                        type="email"
                        class="form-control"
                        @bind-Value="_register.Email"
                        placeholder="johnbrown@example.com"
                        autocomplete="email" />
                <ValidationMessage For="@(() => _register.Email)" />
            </div>

            <div class="form-group">
                <label for="reg-phone">Phone number</label>
                <InputText id="reg-phone"
                        type="tel"
                        class="form-control"
                        @bind-Value="_register.PhoneNumber"
                        placeholder="+254712345678"
                        autocomplete="tel" />
                @* <span class="auth-hint">Use international E.164 format (e.g. +254712345678).</span> *@
                <ValidationMessage For="@(() => _register.PhoneNumber)" />
            </div>
        </div>    

        <div class="form-group">
            <label for="reg-password">Password</label>
            <div class="password-input-wrapper">
                <InputText id="reg-password"
                           type="@(_showPassword ? "text" : "password")"
                           class="form-control"
                           @bind-Value="_register.Password"
                           placeholder="At least 12 characters"
                           autocomplete="new-password" />
                <button type="button"
                        class="password-toggle"
                        aria-label="@(_showPassword ? "Hide password" : "Show password")"
                        aria-pressed="@_showPassword"
                        @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Hide" : "Show")
                </button>
            </div>
            @* <span class="auth-hint">Must be 12–128 characters long.</span> *@
            <ValidationMessage For="@(() => _register.Password)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_isLoading">
            @if (_isLoading)
            {
                <span class="spinner-border" role="status" aria-hidden="true"></span>
                <span>Creating account…</span>
            }
            else
            {
                <span>Create account</span>
            }
        </button>
    </EditForm>

    <p class="auth-footer">
        Already have an account? <a href="/login" class="auth-link">Sign in</a>
    </p>
</div>

@code {
    private readonly RegistrationRequest _register = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private bool _isLoading;
    private bool _showPassword;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_register);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnFieldChanged += (_, args) => _messageStore.Clear(args.FieldIdentifier);
    }

    private async Task HandleRegistrationAsync()
    {
        if (_isLoading) return;

        _isLoading = true;
        _errorMessage = null;
        _messageStore.Clear();

        try
        {
            var result = await AuthApi.RegisterAsync(_register);

            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/login?registered=true");
                return;
            }

            var unmapped = _editContext.ApplyFieldErrors(_messageStore, _register, result.FieldErrors);
            _errorMessage = unmapped.Count > 0
                ? string.Join(" ", unmapped)
                : (result.ErrorMessage ?? "Registration failed. Please check your inputs.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}