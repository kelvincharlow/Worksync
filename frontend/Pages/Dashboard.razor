
@page "/dashboard"
@attribute [Authorize(Policy = "ActiveUser")]

@inject AuthState Auth
@inject UserApiService UserApi

<PageTitle>Overview · Worksync</PageTitle>

<MudStack Spacing="4">

    <div class="d-flex justify-space-between align-start flex-wrap gap-3">

        @if (Auth.IsActiveAdmin)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       Disabled="@_isLoading"
                       OnClick="LoadOverviewAsync">
                @(_isLoading ? "Refreshing…" : "Refresh")
            </MudButton>
        }

    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @_errorMessage
        </MudAlert>
    }

    @if (Auth.IsActiveAdmin)
    {
        <MudGrid Spacing="3">

            <MudItem xs="6" md="3">
                <div class="ws-stat-card">
                    <div class="ws-stat-head">
                        <span>Pending Approval</span>
                        <span class="ws-stat-icon amber">
                            <MudIcon Icon="@Icons.Material.Outlined.Schedule"
                                     Size="Size.Small" />
                        </span>
                    </div>
                    <div class="ws-stat-value">
                        @(_isLoading ? "—" : _pendingCount.ToString())
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="ws-stat-card">
                    <div class="ws-stat-head">
                        <span>Active Accounts</span>
                        <span class="ws-stat-icon green">
                            <MudIcon Icon="@Icons.Material.Outlined.HowToReg"
                                     Size="Size.Small" />
                        </span>
                    </div>
                    <div class="ws-stat-value">
                        @(_isLoading ? "—" : _activeCount.ToString())
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="ws-stat-card">
                    <div class="ws-stat-head">
                        <span>Rejected Accounts</span>
                        <span class="ws-stat-icon red">
                            <MudIcon Icon="@Icons.Material.Outlined.Close"
                                     Size="Size.Small" />
                        </span>
                    </div>
                    <div class="ws-stat-value">
                        @(_isLoading ? "—" : _rejectedCount.ToString())
                    </div>
                </div>
            </MudItem>

            <MudItem xs="6" md="3">
                <div class="ws-stat-card">
                    <div class="ws-stat-head">
                        <span>Blocked Accounts</span>
                        <span class="ws-stat-icon indigo">
                            <MudIcon Icon="@Icons.Material.Outlined.Block"
                                     Size="Size.Small" />
                        </span>
                    </div>
                    <div class="ws-stat-value">
                        @(_isLoading ? "—" : _blockedCount.ToString())
                    </div>
                </div>
            </MudItem>

        </MudGrid>
    }
    else
    {
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">

            <MudPaper Elevation="2"
                      Class="pa-6 pa-sm-8"
                      Style="border-radius: 14px;">

                <MudStack Spacing="4">

                    <div>
                        <h1 class="mud-typography mud-typography-h4 font-weight-bold mb-1">
                            Account status
                        </h1>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Signed in as <strong>@Auth.User?.Email</strong>
                        </MudText>
                    </div>

                    <MudAlert Severity="Severity.Success"
                              Variant="Variant.Outlined">

                        <strong>Account active.</strong>
                        Your account is active and currently awaiting a task and
                        role assignment from your project manager.

                    </MudAlert>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">
                            @_errorMessage
                        </MudAlert>
                    }

                    <MudStack Row="true" Spacing="2" Class="flex-wrap pt-2">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@_isLoading"
                                   OnClick="LoadOverviewAsync">

                            @(_isLoading ? "Refreshing…" : "Refresh")

                        </MudButton>

                    </MudStack>

                </MudStack>

            </MudPaper>

        </MudContainer>
    }

</MudStack>
